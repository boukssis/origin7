# Public site URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only when the site is an authorised Origin7 publication.
# Until then the site stays noindexed.
SITE_LAUNCHED=false

# Optional Basic-auth gate for a private concept preview.
PREVIEW_PASSWORD=

# Contact form delivery stays off until an authorised destination is configured.
CONTACT_DELIVERY_ENABLED=false
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
